# Supabase loyihangiz: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Faqat "anon public" kalit. service_role kalitini HECH QACHON bu yerga yozmang.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# (ixtiyoriy) VITE_PREVIEW=1 — sahifani boshqa sayt ichida (iframe) ko‘rsatish uchun yig‘ish: #nom marshrutlari
# Saytning ochiq manzili (Open Graph va ulashish havolalari uchun), oxirida "/" siz
VITE_SITE_URL=https://bayrogim.example.uz
